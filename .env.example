NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/agrolink

JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=7d

# Comma-separated origins for CORS. Example:
# CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_ORIGIN=*

# Paystack secret key for payment initialize/verify endpoints
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_key

# Admin bootstrap credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password
ADMIN_NAME=Admin

# SMS service (if used)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=Agrolink

# Email notifications (if used)
EMAIL_FROM=no-reply@agrolink.com
SMTP_URL=

# Script/test variables
API_BASE_URL=http://localhost:5000
PAYMENT_CALLBACK_URL=http://localhost:3000/payment-success

# Frontend public API URLs
NEXT_PUBLIC_API_URL=http://localhost:5000/api
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Subscription fee (if used)
SUBSCRIPTION_FEE=0
